@page "/administracao"

<PageTitle>Administração — DocsViewer Omni</PageTitle>

<section class="admin-index">
    <h1>Administração</h1>
    <p class="admin-index__subtitle">Cadastros de apoio à classificação documental.</p>

    <div class="admin-index__cards">
        <a class="admin-index-card" href="administracao/categorias">
            <h2 class="admin-index-card__title">Categorias</h2>
            <p class="admin-index-card__description">Criar, listar e editar categorias documentais hierárquicas.</p>
        </a>

        <a class="admin-index-card" href="administracao/tipos-documentais">
            <h2 class="admin-index-card__title">Tipos documentais</h2>
            <p class="admin-index-card__description">Criar, listar e editar tipos documentais configuráveis.</p>
        </a>
    </div>
</section>
