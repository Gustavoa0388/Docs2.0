@page "/Error"
@using System.Diagnostics

<PageTitle>Erro — DocsViewer Omni</PageTitle>

<h1 class="text-danger">Erro.</h1>
<h2 class="text-danger">Ocorreu um erro ao processar sua solicitação.</h2>

@if (ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@RequestId</code>
    </p>
}

<h3>Modo de desenvolvimento</h3>
<p>
    Ao alternar para o ambiente <strong>Development</strong>, informações mais detalhadas sobre o erro
    ocorrido serão exibidas.
</p>
<p>
    <strong>O ambiente Development não deve ser habilitado em aplicações implantadas.</strong>
    Isso pode expor informações sensíveis de exceções aos usuários finais.
</p>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
